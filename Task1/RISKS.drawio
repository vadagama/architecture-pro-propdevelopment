        <mxCell id="e12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontStyle=2;arcSize=10;" value="Устаревшие визуализации объектов снижают конверсию, но не несут юридических или финансовых рисков" vertex="1">
